# Copy to .env.local and fill in. Never commit the real .env.local.

# Supabase (Settings → API in your Supabase project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Razorpay (Settings → API Keys). Use TEST mode keys until payments are
# verified end-to-end — see guardrail.md.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard → Webhooks: URL https://<your-domain>/api/payments/webhook,
# event "order.paid", and the secret you set there.
RAZORPAY_WEBHOOK_SECRET=
# Escrow needs Razorpay Route enabled on your account. Leave false until then —
# the app works as before (milestones approved without funding).
PAYMENTS_ENABLED=false

# Supabase service role key (Settings → API). SERVER ONLY — never prefix with
# NEXT_PUBLIC_. Used only by lib/payments to write the payments ledger.
SUPABASE_SERVICE_ROLE_KEY=

# Gemini API key (https://aistudio.google.com/app/apikey): embeddings for
# semantic search, and the default model for AI features. Optional — without
# it search falls back to keywords and AI features are off.
GEMINI_API_KEY=


# Public site URL, used in emails, the sitemap and canonical links
NEXT_PUBLIC_SITE_URL=

# Email notifications via Resend (`vercel integration add resend` sets the key).
# EMAIL_FROM must be an address on a domain you verified in Resend, e.g.
# "CollabLance <notify@yourdomain.in>". Leave empty to send no emails.
RESEND_API_KEY=
EMAIL_FROM=

# Plausible analytics: your site's domain as registered in Plausible. Leave
# empty for no analytics. Loads only after the visitor clicks "Accept All".
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ── Phase 2: AI features (LangChain) ─────────────────────────────
# Chat model. With AI_GATEWAY_API_KEY set, AI features use Claude through
# Vercel AI Gateway (needs a card on file with Vercel). Without it they use
# Gemini with GEMINI_API_KEY above. AI_MODEL overrides the Gemini model name.
AI_GATEWAY_API_KEY=
AI_MODEL=

# Chroma vector database, for semantic search and team matching. Without it,
# search and matching fall back to keywords. Use ONE of:
#   Chroma Cloud (trychroma.com): API key, tenant and database
#   Self-hosted: CHROMA_URL, e.g. http://localhost:8000 (`chroma run`)
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
CHROMA_URL=
