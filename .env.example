# Copy to .env.local and fill in. Never commit the real .env.local.

# Supabase (Settings → API in your Supabase project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Razorpay (Settings → API Keys). Use TEST mode keys until payments are
# verified end-to-end — see guardrail.md.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Gemini API key, for Team Context embeddings/semantic search
# (https://aistudio.google.com/app/apikey). Optional — context sharing
# falls back to plain text search without it.
GEMINI_API_KEY=

# Set automatically by `vercel link` + `vercel dev` / the Vercel platform —
# authenticates AI Gateway requests from the AI chatbot. Not needed if you
# set AI_GATEWAY_API_KEY instead.
VERCEL_OIDC_TOKEN=
